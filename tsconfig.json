{
  "compilerOptions": {
    "moduleResolution": "node",
    "module": "commonjs",
    "target": "es2018",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDir": "./src",
    "outDir": "dist",
    "preserveConstEnums": true,
    "noUncheckedIndexedAccess": true,
    "sourceMap": true,
    "sourceRoot": "./",
    "inlineSources": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
